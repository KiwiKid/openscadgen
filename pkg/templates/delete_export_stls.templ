package templates

import (
	"fmt"
	"sort"
)

type DeleteExportSTLsPageData struct {
	RootDir              string
	ConfigFilePath       string
	ConfigVersion        string
	CurrentVersionFiles  []string
	OtherVersionFiles    map[string][]string
	SelectedOtherVersion bool
	PreviewOnly          bool
	Confirmed            bool
	Deleted              []string
	Failed               map[string]string
	Error                string
}

func sortedKeys(m map[string]string) []string {
	keys := make([]string, 0, len(m))
	for k := range m {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	return keys
}

templ DeleteExportSTLsPage(data DeleteExportSTLsPageData) {
	<div class="box">
		<h2 class="title is-5">Clear Existing Files</h2>
		if data.Error != "" {
			<div class="notification is-danger">{ data.Error }</div>
		}
		if len(data.Deleted) > 0 {
			<div class="notification is-success">Deleted { fmt.Sprintf("%d", len(data.Deleted)) } files.</div>
		}
		if len(data.Failed) > 0 {
			<div class="notification is-warning">
				Failed to delete { fmt.Sprintf("%d", len(data.Failed)) } files.
				<ul>
					for _, k := range sortedKeys(data.Failed) {
						<li><code>{ k }</code>: { data.Failed[k] }</li>
					}
				</ul>
			</div>
		}
		<p class="mb-2"><strong>Config:</strong> <code>{ data.ConfigFilePath }</code></p>
		<p class="mb-3"><strong>Version:</strong> <code>{ data.ConfigVersion }</code></p>
		if len(data.CurrentVersionFiles) == 0 {
			<p class="has-text-grey">No files found in the current version.</p>
		} else {
			if !data.Confirmed {
				<form method="POST" action="/delete-export-stls" hx-post="/delete-export-stls" hx-target="#delete-status" hx-swap="innerHTML">
					<input type="hidden" name="config_path" value={ data.ConfigFilePath }/>
					<input type="hidden" name="version" value={ data.ConfigVersion }/>
					<input type="hidden" name="confirmed" value="true"/>
					<input type="hidden" name="include_other_versions" value={ fmt.Sprintf("%t", data.SelectedOtherVersion) }/>
					<div class="buttons">
						<button class="button is-danger" type="submit">Delete { fmt.Sprintf("%d", len(data.CurrentVersionFiles)) } files</button>
					</div>
				</form>
				<p class="mt-4"><strong>Sample files:</strong></p>
				<ul>
					for i, f := range data.CurrentVersionFiles {
						if i < 10 {
							<li><code>{ f }</code></li>
						}
					}
				</ul>
			} else {
				<p><strong>Are you sure you want to delete { fmt.Sprintf("%d", len(data.CurrentVersionFiles)) } files?</strong></p>
				<ul>
					for i, f := range data.CurrentVersionFiles {
						if i < 10 {
							<li><code>{ f }</code></li>
						}
					}
				</ul>
				<form method="POST" action="/delete-export-stls" hx-post="/delete-export-stls" hx-target="#delete-status" hx-swap="innerHTML">
					<input type="hidden" name="config_path" value={ data.ConfigFilePath }/>
					<input type="hidden" name="version" value={ data.ConfigVersion }/>
					<input type="hidden" name="confirmed" value="true"/>
					<input type="hidden" name="include_other_versions" value={ fmt.Sprintf("%t", data.SelectedOtherVersion) }/>
					<div class="buttons">
						<button class="button is-danger" type="submit">Confirm Delete</button>
					</div>
				</form>
			}
		}
		if len(data.OtherVersionFiles) > 0 {
			<hr/>
			<form method="GET" action="/delete-export-stls" hx-get="/delete-export-stls" hx-target="#delete-status" hx-swap="innerHTML">
				<input type="hidden" name="config_path" value={ data.ConfigFilePath }/>
				<input type="hidden" name="version" value={ data.ConfigVersion }/>
				<label class="checkbox">
					<input type="checkbox" name="include_other_versions" value="true" checked={ data.SelectedOtherVersion }/>
					Clear other versions too ({ fmt.Sprintf("%d", len(data.OtherVersionFiles)) } files)
				</label>
				<button class="button is-light ml-3" type="submit">Update preview</button>
			</form>
		}
	</div>
}
