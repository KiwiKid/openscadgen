package templates

import (
	"fmt"
	"strings"

	"github.com/kiwikid/openscadgen/pkg/models"
)

func configAutoReloadStorageKey(configPathEncoded string) string {
	return "openscadgen-config-auto-reload:" + configPathEncoded
}

templ EditPreviewSummaryGrid(items []models.EditPreviewSummary) {
	<div class="columns is-multiline mt-3">
		for _, item := range items {
			<div class="column is-3">
				<div class="box">
					<p class="heading">{ item.Label }</p>
					<p class="title is-5">{ item.Value }</p>
				</div>
			</div>
		}
	</div>
}

templ EditPreviewSectionList(sections []models.EditPreviewSection) {
	for _, section := range sections {
		<section class="config-editor-section mb-5" aria-labelledby={ "config-section-" + section.Title }>
			<div class="is-flex is-justify-content-space-between is-align-items-flex-start mb-3">
				<div>
					<h2 id={ "config-section-" + section.Title } class="is-size-6 has-text-weight-semibold mb-1">{ section.Title }</h2>
					<p class="is-size-7 has-text-grey mb-0">{ section.Description }</p>
				</div>
				if section.CountLabel != "" {
					<span class="tag is-light ml-3">{ section.CountLabel }</span>
				}
			</div>
			<div class="table-container">
				<table class="table is-fullwidth is-hoverable is-striped is-narrow">
					<thead><tr><th>Name</th><th>Details</th><th>Description</th><th class="has-text-right">Actions</th></tr></thead>
					<tbody id={ "config-table-" + section.Title }>
						for _, item := range section.Items {
							<tr>
								<td class="has-text-weight-semibold">{ item.Title }</td>
								<td class="is-size-7 has-text-grey">{ item.Subtitle }</td>
								<td class="is-size-7">{ item.Description }</td>
								<td class="has-text-right">
									if section.Title == "instances" || section.Title == "param_sets" || section.Title == "images" || section.Title == "global_params" || section.Title == "input_paths" || section.Title == "export_name_format" || section.Title == "attribution" || section.Title == "publication" {
										<button type="button" class="button is-small is-light" data-config-editor-edit={ section.Title } data-config-editor-name={ item.Title }>Edit</button>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if section.Title == "instances" || section.Title == "param_sets" || section.Title == "images" || section.Title == "global_params" || section.Title == "input_paths" || section.Title == "publication" || (section.Title == "attribution" && !section.HasItems) {
				<button type="button" class="button is-small is-link is-light" data-config-editor-add={ section.Title }>Add { strings.TrimSuffix(section.Title, "s") }</button>
			}
		</section>
	}
}

templ EditConfigPanel(editFormConfig *models.EditConfigParams) {
	<div class="container">
		<div
			id="config-file-change-check"
			hx-get={ templ.SafeURL(fmt.Sprintf("/api/config/changed?config_path=%s&server_folder=%s&fingerprint=%s", editFormConfig.ConfigFilePathEncoded, editFormConfig.ServerFolderEncoded, editFormConfig.FileFingerprint)) }
			hx-trigger="every 30s [document.hasFocus()]"
			hx-vals={ fmt.Sprintf(`js:{auto_reload: sessionStorage.getItem(%q) === 'true'}`, configAutoReloadStorageKey(editFormConfig.ConfigFilePathEncoded)) }
			hx-swap="outerHTML"
		></div>
		<div class="level is-mobile mb-4">
			<div class="level-left">
				<div class="level-item">
					<div class="buttons are-small">
						<a class="button is-light" hx-get={ templ.SafeURL(editFormConfig.ReportURL) } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">Back to Instances</a>
						<a class="button is-warning" href={ templ.SafeURL(fmt.Sprintf("/?config=%s", editFormConfig.ConfigFilePathEncoded)) }>Open Report</a>
					</div>
				</div>
			</div>
		</div>
		<h1 class="title is-4">Edit TOML File</h1>
		<div class="file-path">{ strings.TrimPrefix(editFormConfig.ConfigFilePath, "/") }</div>
		if editFormConfig.ErrorMsg != nil {
			@editFormConfig.ErrorMsg
		}
		if len(editFormConfig.PreviewSummary) > 0 {
			@EditPreviewSummaryGrid(editFormConfig.PreviewSummary)
		}
		<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/api/edit?config_path=%s&server_folder=%s", editFormConfig.ConfigFilePathEncoded, editFormConfig.ServerFolderEncoded)) } hx-post={ templ.SafeURL(fmt.Sprintf("/api/edit?config_path=%s&server_folder=%s", editFormConfig.ConfigFilePathEncoded, editFormConfig.ServerFolderEncoded)) } hx-target="#main-content" hx-swap="innerHTML">
			<div class="buttons">
				<button id="config-recheck" type="submit" class="button is-info" name="action" value="recheck">Re-check</button>
				<button
					type="submit"
					class="button is-success"
					name="action"
					value="save"
					if !editFormConfig.IsPreview || editFormConfig.SaveBlocked {
						disabled
					}
				>Save Changes</button>
			</div>
			if len(editFormConfig.PreviewFeedback) > 0 {
				<div class="mt-4">
					for _, feedback := range editFormConfig.PreviewFeedback {
						if feedback.IsSaveBlocking {
							<div class="notification is-danger">
								<p class="has-text-weight-semibold">
									Save-blocking error
								</p>
								<p style="white-space: pre-wrap;">{ feedback.Message }</p>
								if len(feedback.ExportNameFormatFixes) > 0 {
									<p class="mt-3 mb-2 is-size-7 has-text-weight-semibold">Add the missing reference to:</p>
									<div class="buttons are-small">
										for _, fix := range feedback.ExportNameFormatFixes {
											<button type="button" class="button is-danger is-light" data-config-export-format-fix data-config-export-format-scope={ fix.Scope } data-config-export-format-selector={ fix.Selector } data-config-export-format-placeholders={ strings.Join(fix.Placeholders, " ") }>Fix { fix.Label }: add { strings.Join(fix.Placeholders, " ") }</button>
										}
									</div>
								}
							</div>
						} else {
							<div class="notification is-warning">
								<p class="has-text-weight-semibold">Warning</p>
								<p style="white-space: pre-wrap;">{ feedback.Message }</p>
							</div>
						}
					}
				</div>
			}
			if editFormConfig.IsPreview {
				<div class="mt-5">
					<h2 class="title is-5 mb-2">Configuration</h2>
					<p class="is-size-7 has-text-grey mb-4">Edit a row, apply it to the dry run, then save the validated configuration.</p>
					@EditPreviewSectionList(editFormConfig.PreviewSections)
				</div>
			}
			<details class="mt-5">
				<summary>Full TOML source</summary>
				<textarea id="config-content" class="textarea is-family-monospace mt-3" style="height: 350px;" name="content">{ editFormConfig.Content }</textarea>
			</details>
		</form>
		<script>
			(() => {
				const source = document.getElementById('config-content');
				if (!source) return;
				const escapeToml = (value) => `"${value.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`;
				const topLevelHeader = (type) => type === 'attribution' ? '[attribution]' : type === 'publication' ? '[[publication]]' : `[[openscadgen.${type}]]`;
				const isLink = type => type === 'attribution' || type === 'publication';
				function blocks(type) {
					const lines = source.value.split('\n'); const result = []; let start = -1;
					for (let i = 0; i <= lines.length; i++) {
						const isHeader = i < lines.length && lines[i].trim() === topLevelHeader(type);
						const isOtherTopLevel = i < lines.length && (/^\[\[openscadgen\.[^.\]]+\]\]$/.test(lines[i].trim()) || /^\[\[?[^.\]]+\]\]?$/.test(lines[i].trim()));
						if (start >= 0 && (i === lines.length || (isOtherTopLevel && !isHeader))) { result.push({ start, end: i, lines: lines.slice(start, i) }); start = -1; }
						if (isHeader) { if (start >= 0) result.push({ start, end: i, lines: lines.slice(start, i) }); start = i; }
					}
					if (start >= 0) result.push({ start, end: lines.length, lines: lines.slice(start) }); return result;
				}
				function value(lines, key) { const match = lines.join('\n').match(new RegExp(`^${key}\\s*=\\s*(.+)$`, 'm')); return match ? match[1].trim() : ''; }
				function stringValue(lines, key) { const raw = value(lines, key); const match = raw.match(/^"(.*)"$/); if (match) return match[1].replace(/\\"/g, '"').replace(/\\\\/g, '\\'); const literal = raw.match(/^'(.*)'$/); return literal ? literal[1] : ''; }
				function setValue(lines, key, raw) { const re = new RegExp(`^${key}\\s*=.*$`); const at = lines.findIndex(line => re.test(line)); if (!raw) { if (at >= 0) lines.splice(at, 1); return; } if (at >= 0) lines[at] = `${key} = ${raw}`; else lines.push(`${key} = ${raw}`); }
				function configBlock(scope, selector) {
					const lines = source.value.split('\n');
					if (scope === 'global') { const end = lines.findIndex((line, i) => i > 0 && /^\[/.test(line.trim())); return { lines, start: 0, end: end < 0 ? lines.length : end }; }
					const header = `[[openscadgen.${scope}]]`; let start = -1;
					for (let i = 0; i <= lines.length; i++) { if (i < lines.length && lines[i].trim() === header) { start = i; continue; } if (start >= 0 && (i === lines.length || (i < lines.length && /^\[\[openscadgen\./.test(lines[i].trim())))) { const block = lines.slice(start, i); const key = scope === 'instances' ? 'name' : 'path'; if (stringValue(block, key) === selector) return { lines, start, end: i }; start = -1; } }
					return null;
				}
				function applyExportFormatFix(scope, selector, placeholders) {
					const block = configBlock(scope, selector); if (!block) return;
					const target = block.lines.slice(block.start, block.end); const current = stringValue(target, 'export_name_format');
					const additions = placeholders.filter(item => !current.includes(item)); if (!additions.length) return;
					setValue(target, 'export_name_format', escapeToml(`${current}${current ? '_' : ''}${additions.join('_')}`));
					block.lines.splice(block.start, block.end - block.start, ...target); source.value = block.lines.join('\n'); document.getElementById('config-recheck').click();
				}
				function editorInput(label, key, placeholder = '', width = 'is-4') { return `<div class="column ${width}"><label class="label is-small">${label}</label><input class="input is-small" data-field="${key}" placeholder="${placeholder}"/></div>`; }
				function globalLines() { const lines = source.value.split('\n'); const end = lines.findIndex(line => /^\[/.test(line.trim()) && line.trim() !== '[openscadgen]'); return lines.slice(0, end < 0 ? lines.length : end); }
				function setGlobalValue(key, raw) { const all = source.value.split('\n'); const end = all.findIndex(line => /^\[/.test(line.trim()) && line.trim() !== '[openscadgen]'); const originalLength = end < 0 ? all.length : end; const global = all.slice(0, originalLength); setValue(global, key, raw); all.splice(0, originalLength, ...global); source.value = all.join('\n'); }
				function open(type, name, after) {
					document.querySelectorAll('[data-config-inline-editor]').forEach(row => row.remove());
					const identifier = isLink(type) ? 'url' : type === 'input_paths' ? 'path' : 'name';
					const target = name && blocks(type).find(block => stringValue(block.lines, identifier) === name);
					const row = document.createElement('tr'); row.dataset.configInlineEditor = 'true';
					const fields = [editorInput(isLink(type) ? 'URL' : type === 'input_paths' ? 'Path' : 'Name', identifier)];
					if (isLink(type)) fields.push(editorInput('Label (optional)', 'label'), editorInput('Author (optional)', 'author'), editorInput('Subtitle (optional)', 'subtitle'));
					if (type === 'instances') fields.push(editorInput('Parameters', 'params', '{ width = 120 }'), editorInput('Description', 'description'), editorInput('Param sets', 'param_sets', 'wide,tall'), editorInput('Export name format', 'export_name_format'), '<div class="column is-4"><label class="checkbox mt-5"><input data-field="skip_images" type="checkbox"/> Skip images</label></div>');
					if (type === 'param_sets') fields.push(editorInput('Parameters', 'params', '{ width = 120 }'));
					if (type === 'images') fields.push(editorInput('Camera coordinate / preset', 'coord', 'nice'), editorInput('Image size', 'image_size', '1200x1200'), editorInput('Type', 'type', 'all_instances'), editorInput('Parameter filter', 'param_filter', '{ finish = "matte" }'));
					if (type === 'input_paths') fields.push(editorInput('Parameters', 'params', '{ width = 120 }'), editorInput('Param sets', 'param_sets', 'wide,tall'), editorInput('Export name format', 'export_name_format'), '<div class="column is-4"><label class="checkbox mt-5"><input data-field="skip_images" type="checkbox"/> Skip images</label></div>');
					if (type === 'global_params') { fields.length = 0; fields.push(editorInput('Parameter', 'name'), editorInput('TOML value', 'value', '2.4', 'is-8')); }
					if (type === 'export_name_format') { fields.length = 0; fields.push(editorInput('Export name format', 'value', '{designFileName}_{paramSet}', 'is-12')); }
					row.innerHTML = `<td colspan="4"><div class="has-background-light p-4"><p class="has-text-weight-semibold mb-3">${name ? 'Edit' : 'Add'} ${type.replace('_', ' ').replace(/s$/, '')}</p><div class="columns is-multiline">${fields.join('')}</div><div class="buttons mb-0"><button type="button" class="button is-small is-link" data-config-inline-apply>Apply to dry run</button><button type="button" class="button is-small is-light" data-config-inline-cancel>Cancel</button></div></div></td>`;
					if (after) after.insertAdjacentElement('afterend', row); else document.getElementById(`config-table-${type}`).appendChild(row);
					const set = (key, val) => { const input = row.querySelector(`[data-field="${key}"]`); if (input) input.type === 'checkbox' ? input.checked = val === 'true' : input.value = val; };
					const lines = target ? target.lines : []; ['url', 'label', 'author', 'subtitle', 'name', 'path', 'params', 'description', 'param_sets', 'export_name_format', 'coord', 'image_size', 'type', 'param_filter', 'skip_images'].forEach(key => set(key, key === 'params' || key === 'param_filter' || key === 'skip_images' ? value(lines, key) : stringValue(lines, key)));
					if (type === 'global_params') { set('name', name); set('value', value(globalLines(), name)); }
					if (type === 'export_name_format') set('value', stringValue(globalLines(), 'export_name_format'));
					row.querySelector('[data-config-inline-cancel]').addEventListener('click', () => row.remove());
					row.querySelector('[data-config-inline-apply]').addEventListener('click', () => apply(type, name, target, row)); row.querySelector(`[data-field="${identifier}"]`)?.focus();
				}
				function apply(type, originalName, target, row) {
					const input = key => row.querySelector(`[data-field="${key}"]`); const text = key => input(key)?.value.trim() || '';
					if (type === 'global_params') { const name = text('name'); if (!name) { input('name').focus(); return; } if (originalName && originalName !== name) setGlobalValue(originalName, ''); setGlobalValue(name, text('value')); document.getElementById('config-recheck').click(); return; }
					if (type === 'export_name_format') { setGlobalValue('export_name_format', text('value') && escapeToml(text('value'))); document.getElementById('config-recheck').click(); return; }
					const identifier = isLink(type) ? 'url' : type === 'input_paths' ? 'path' : 'name'; const name = text(identifier); if (!name) { input(identifier).focus(); return; }
					const lines = target ? [...target.lines] : [topLevelHeader(type)];
					setValue(lines, identifier, escapeToml(name));
					if (isLink(type)) ['label', 'author', 'subtitle'].forEach(key => setValue(lines, key, text(key) && escapeToml(text(key))));
					if (type === 'instances') { setValue(lines, 'description', text('description') && escapeToml(text('description'))); setValue(lines, 'params', text('params')); setValue(lines, 'param_sets', text('param_sets') && escapeToml(text('param_sets'))); setValue(lines, 'export_name_format', text('export_name_format') && escapeToml(text('export_name_format'))); setValue(lines, 'skip_images', input('skip_images').checked ? 'true' : ''); }
					if (type === 'param_sets') setValue(lines, 'params', text('params'));
					if (type === 'images') { setValue(lines, 'coord', text('coord') && escapeToml(text('coord'))); setValue(lines, 'image_size', text('image_size') && escapeToml(text('image_size'))); setValue(lines, 'type', text('type') && escapeToml(text('type'))); setValue(lines, 'param_filter', text('param_filter')); }
					if (type === 'input_paths') { setValue(lines, 'params', text('params')); setValue(lines, 'param_sets', text('param_sets') && escapeToml(text('param_sets'))); setValue(lines, 'export_name_format', text('export_name_format') && escapeToml(text('export_name_format'))); setValue(lines, 'skip_images', input('skip_images').checked ? 'true' : ''); }
					const all = source.value.split('\n'); if (target) all.splice(target.start, target.end - target.start, ...lines); else { if (all.length && all[all.length - 1].trim()) all.push(''); all.push(...lines); } source.value = all.join('\n');
					document.getElementById('config-recheck').click();
				}
				document.querySelectorAll('[data-config-editor-add]').forEach(button => button.addEventListener('click', () => open(button.dataset.configEditorAdd)));
				document.querySelectorAll('[data-config-editor-edit]').forEach(button => button.addEventListener('click', () => open(button.dataset.configEditorEdit, button.dataset.configEditorName, button.closest('tr'))));
				document.querySelectorAll('[data-config-export-format-fix]').forEach(button => button.addEventListener('click', () => applyExportFormatFix(button.dataset.configExportFormatScope, button.dataset.configExportFormatSelector, button.dataset.configExportFormatPlaceholders.split(' ').filter(Boolean))));
			})();
		</script>
	</div>
}

templ ConfigFileChangedWarning(refreshURL string, storageKey string) {
	<div id="config-file-change-check" class="notification is-warning is-light mb-4" role="status">
		<p class="has-text-weight-semibold mb-3">File has changed</p>
		<p class="mb-4">Refresh to see the latest config.</p>
		<label class="checkbox mb-4">
			<input id="config-file-auto-reload" type="checkbox" data-storage-key={ storageKey }/>
			Auto-reload file on change and don't show this message again
		</label>
		<a class="button is-warning is-large is-fullwidth" href={ templ.SafeURL(refreshURL) }>Refresh</a>
		<script>
			(() => {
				const checkbox = document.getElementById('config-file-auto-reload');
				if (!checkbox) return;
				const storageKey = checkbox.dataset.storageKey;
				try {
					checkbox.checked = sessionStorage.getItem(storageKey) === 'true';
					checkbox.addEventListener('change', () => sessionStorage.setItem(storageKey, String(checkbox.checked)));
				} catch (_) {
					// Session storage is optional; the warning still works if it is unavailable.
				}
			})();
		</script>
	</div>
}
