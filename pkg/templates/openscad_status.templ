package templates

import "fmt"

func bosl2ActionDisabledReason(available bool) string {
	if available {
		return ""
	}
	return "OpenSCAD must be installed before BOSL2 can be installed or upgraded."
}

func bosl2InstallUnsupportedMessage() string {
	return "BOSL2 installation is currently supported on macOS only."
}

// OpenSCADNavView is server-side state for the nav OpenSCAD probe widget.
type OpenSCADNavView struct {
	Available bool
	Path      string
	Version   string
	Error     string
	// Reason is a one-line explanation of why OpenSCAD is unusable (missing,
	// not runnable) and stays empty when OpenSCAD works.
	Reason string
	// Hint carries an actionable prerequisite fix for a detected Reason, such
	// as the runtime libraries OpenSCAD needs on headless Linux.
	Hint string
	// ManualInstallCommand is the per-platform install/upgrade steps shown when
	// the automated install is unavailable or fails.
	ManualInstallCommand  string
	OutOfDate             bool
	InstallSupported      bool
	InstallSupportLabel   string
	BOSL2Available        bool
	BOSL2ActionLabel      string
	BOSL2InstallSupported bool
	BOSL2Error            string
	DetailsOpen           bool // from ?isExpanded=1 on /api/openscad/status
}

// OpenSCADWarningSlot is the HTMX slot that loads the OpenSCAD warning banner.
// It renders an empty, inert slot when OpenSCAD is available.
templ OpenSCADWarningSlot(v OpenSCADNavView) {
	if v.Available {
		<div id="openscad-warning-slot" hx-get="/api/openscad/status?fragment=banner" hx-trigger="load" hx-swap="outerHTML"></div>
	} else {
		<article id="openscad-warning-slot" class="notification is-warning" data-openscad-warning="missing-renderer">
			<p class="has-text-weight-bold mb-2">OpenSCAD is not available — rendering is disabled</p>
			if v.Reason != "" {
				<p class="mb-2">{ v.Reason }</p>
			}
			<p class="mb-2">
				openscadgen keeps running: you can browse, edit and create configs, but STL and preview-image renders will fail until OpenSCAD is available.
			</p>
			if v.Hint != "" {
				<p class="has-text-weight-semibold mb-1">Missing prerequisite</p>
				<pre id="openscad-warning-hint" class="p-2 mb-2" style="white-space:pre-wrap;word-break:break-word;background:rgba(0,0,0,0.04);border-radius:4px;">{ v.Hint }</pre>
			}
			if v.InstallSupported {
				<div class="buttons are-small mb-2">
					<button
						type="button"
						class="button is-link is-small"
						hx-post="/api/openscad/install"
						hx-vals='js:{install_nightly: "false"}'
						hx-target="#openscad-warning-install-result"
						hx-swap="innerHTML"
					>Install OpenSCAD</button>
					<button
						type="button"
						class="button is-link is-light is-small"
						hx-post="/api/openscad/install"
						hx-vals='js:{install_nightly: "true"}'
						hx-target="#openscad-warning-install-result"
						hx-swap="innerHTML"
					>Install OpenSCAD nightly</button>
				</div>
				<div id="openscad-warning-install-result" class="mb-2"></div>
				<p class="is-size-7 mb-1">If the automatic install fails, install it manually and reload the page:</p>
			} else {
				<p class="is-size-7 mb-1">Automatic install is available for { v.InstallSupportLabel } only. Install OpenSCAD for your platform, then reload the page:</p>
			}
			<pre id="openscad-warning-manual" class="p-2 mb-2" style="white-space:pre-wrap;word-break:break-word;background:rgba(0,0,0,0.04);border-radius:4px;">{ v.ManualInstallCommand }</pre>
			<details class="is-size-7">
				<summary>Diagnostic details</summary>
				<pre class="p-2 mt-1" style="white-space:pre-wrap;word-break:break-word;background:rgba(0,0,0,0.04);border-radius:4px;">{ v.Error }</pre>
			</details>
			<p class="is-size-7 mt-2">
				<a href="/api/openscad/status?fragment=banner">Re-check OpenSCAD</a>
				· <a href="/tools">Open tools</a>
			</p>
		</article>
	}
}

// OpenSCADWarningPlaceholder loads the warning banner on page load. It is a
// no-op when OpenSCAD is available, so pages look unchanged on working installs.
templ OpenSCADWarningPlaceholder() {
	<div id="openscad-warning-slot" hx-get="/api/openscad/status?fragment=banner" hx-trigger="load" hx-swap="outerHTML"></div>
}

// OpenSCADNavWidget shows OpenSCAD OK / No OpenSCAD in a <summary>; details hold path/version.
// Includes #openscad-status with data-* for tests. Expand state: ?isExpanded=1 (see utils.js).
templ OpenSCADNavWidget(v OpenSCADNavView) {
	<div id="openscad-nav-widget" class="openscad-nav-widget">
		<details
			id="openscad-nav-details"
			class="openscad-nav-details"
			if v.DetailsOpen {
				open
			}
		>
			<summary class="openscad-nav-summary">
				<span class="is-inline-flex" style="gap:0.35rem; flex-wrap:wrap; align-items:center;">
					if v.Available {
						<span class="tag is-success is-light">OpenSCAD OK</span>
					} else {
						<span class="tag is-danger is-light">No OpenSCAD</span>
					}
				</span>
			</summary>
			<div
				class="openscad-nav-panel content is-size-7"
				style="max-width:min(90vw, 32rem);margin-top:0.25rem;padding-top:0.5rem;border-top:1px solid rgba(0,0,0,0.08);"
			>
				<div class="is-flex is-justify-content-flex-end mb-2" style="gap:0.5rem;">
					<button
						type="button"
						class="button is-small is-light"
						hx-get="/api/openscad/status?fragment=1"
						hx-vals="js:{isExpanded: document.getElementById(&quot;openscad-nav-details&quot;)?.open ? &quot;1&quot; : undefined}"
						hx-target="closest #openscad-nav-widget"
						hx-swap="outerHTML"
					>Reload</button>
				</div>
				<div class="is-flex is-flex-wrap-wrap is-align-items-center mb-2" style="gap:0.5rem;">
					if v.BOSL2Available {
						<span class="tag is-success is-light">BOSL2</span>
					} else {
						<span class="tag is-warning is-light">BOSL2</span>
					}
					if v.BOSL2InstallSupported {
						<button
							type="button"
							class="button is-small is-link"
							disabled={ !v.Available }
							title={ bosl2ActionDisabledReason(v.Available) }
							hx-post="/api/openscad/libraries/bosl2/update"
							hx-target="#bosl2-install-state"
							hx-swap="innerHTML"
						>{ v.BOSL2ActionLabel } BOSL2</button>
						<span id="bosl2-install-state" class="has-text-grey is-size-7"></span>
						if !v.Available {
							<p class="has-text-grey is-size-7 mt-1">{ bosl2ActionDisabledReason(v.Available) }</p>
						}
						<p class="has-text-grey is-size-7 mt-1">
							BOSL2 is a helper library used by many OpenSCAD models. This will install or upgrade it in your local OpenSCAD libraries on supported platforms.
						</p>
					} else {
						<span class="has-text-grey is-size-7">{ bosl2InstallUnsupportedMessage() }</span>
					}
				</div>
				if v.Available {
					<div class="mb-2">
						<span
							id="openscadgen-health-badge"
							class="tag is-light"
							data-health-url="/health"
							data-health-state="unknown"
						>openscadgen…</span>
					</div>
					<p class="mb-1"><strong>Path</strong></p>
					<pre class="p-2" style="white-space:pre-wrap;word-break:break-all;background:rgba(0,0,0,0.04);border-radius:4px;">{ v.Path }</pre>
					<p class="mb-1 mt-2"><strong>Version</strong></p>
					<pre class="p-2" style="white-space:pre-wrap;word-break:break-all;background:rgba(0,0,0,0.04);border-radius:4px;">{ v.Version }</pre>
					if v.OutOfDate {
						<p class="has-text-warning mt-2">Flagged out-of-date.</p>
					}
					if !v.InstallSupported {
						<p class="has-text-grey mt-2">Automated install runs on { v.InstallSupportLabel } only.</p>
					}
					if v.BOSL2Error != "" {
						<p class="has-text-grey mt-2">{ v.BOSL2Error }</p>
					}
				} else {
					if v.Reason != "" {
						<p class="mb-2">{ v.Reason }</p>
					}
					<p class="mb-1"><strong>Error</strong></p>
					<pre class="p-2" style="white-space:pre-wrap;word-break:break-all;background:rgba(0,0,0,0.04);border-radius:4px;">{ v.Error }</pre>
					if v.Hint != "" {
						<p class="mb-1 mt-2"><strong>Missing prerequisite</strong></p>
						<pre class="p-2" style="white-space:pre-wrap;word-break:break-all;background:rgba(0,0,0,0.04);border-radius:4px;">{ v.Hint }</pre>
					}
					if v.ManualInstallCommand != "" {
						<p class="mb-1 mt-2"><strong>Manual install</strong></p>
						<pre class="p-2" style="white-space:pre-wrap;word-break:break-all;background:rgba(0,0,0,0.04);border-radius:4px;">{ v.ManualInstallCommand }</pre>
					}
					if !v.InstallSupported {
						<p class="has-text-grey mt-2">Automated install runs on { v.InstallSupportLabel } only.</p>
					}
					if v.BOSL2Error != "" {
						<p class="has-text-grey mt-2">{ v.BOSL2Error }</p>
					}
				}
			</div>
		</details>
		<div
			id="openscad-status"
			data-available={ fmt.Sprintf("%t", v.Available) }
			data-path={ v.Path }
			data-version={ v.Version }
			data-out-of-date={ fmt.Sprintf("%t", v.OutOfDate) }
			data-error={ v.Error }
			style="display:none"
			aria-hidden="true"
		></div>
	</div>
}

templ OpenSCADStatusFullPage(v OpenSCADNavView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>OpenSCAD status</title>
			@HeadLinks()
		</head>
		<body>
			<div class="container p-4">
				@OpenSCADNavWidget(v)
			</div>
		</body>
	</html>
}

// OpenSCADNavPlaceholder is swapped by HTMX on first load for the live widget.
templ OpenSCADNavPlaceholder() {
	<div
		id="openscad-nav-widget"
		hx-get="/api/openscad/status?fragment=1"
		hx-vals="js:{isExpanded: new URLSearchParams(window.location.search).get(&quot;isExpanded&quot;) === &quot;1&quot; ? &quot;1&quot; : undefined}"
		hx-trigger="load"
		hx-swap="outerHTML"
	>
		<span class="is-size-7 has-text-grey">OpenSCAD…</span>
	</div>
}
