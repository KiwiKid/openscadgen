package templates

import (
	"fmt"
	"github.com/kiwikid/openscadgen/pkg/models"
	"time"
)

templ ConfigSummary(config models.Config, outputPath string, totalTimeTaken time.Duration) {
	<footer id="config-summary" class="config-summary">
		<details>
			<summary>
				Generated with 💕 by <a href="https://github.com/kiwikid/openscadgen" target="_blank">openscadgen</a> in <span class="config-summary__duration" data-duration-ms={ fmt.Sprintf("%d", totalTimeTaken.Milliseconds()) }>{ formatDuration(totalTimeTaken) }</span> - <span>{ config.OpenSCADVersion } { config.OpenScadGenVersion } at { time.Now().Format("2006-01-02 15:04:05") }</span>
			</summary>
			<div class="config-summary__body">
				<p><strong>Output path:</strong> { outputPath }</p>
				<p><strong>Total time:</strong> { formatDuration(totalTimeTaken) }</p>
				if len(config.Design.GlobalParams) > 0 {
					<h2>Global Parameters</h2>
					for name, value := range config.Design.GlobalParams {
						<p><strong>{ name }:</strong> { fmt.Sprintf("%v", value) }</p>
					}
				} else {
					<p>No global parameters</p>
				}
				<h2>Output Paths</h2>
				<p><strong>OutputPath:</strong> { outputPath }</p>
			</div>
		</details>
		<script>
			(() => {
				const duration = document.currentScript.previousElementSibling.querySelector('.config-summary__duration');
				const milliseconds = Number(duration?.dataset.durationMs);
				if (!Number.isFinite(milliseconds) || milliseconds < 0) return;
				if (milliseconds < 1000) duration.textContent = `${Math.round(milliseconds)} milliseconds`;
				else if (milliseconds < 60000) duration.textContent = `${Math.round(milliseconds / 1000)} seconds`;
				else if (milliseconds < 3600000) duration.textContent = `${Math.round(milliseconds / 60000)} minutes`;
				else duration.textContent = `${(milliseconds / 3600000).toFixed(1)} hours`;
			})();
		</script>
	</footer>
}
