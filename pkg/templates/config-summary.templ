package templates

import (
	"fmt"
	"github.com/kiwikid/openscadgen/pkg/models"
    "time"
)

templ ConfigSummary(config models.Config, outputPath string, totalTimeTaken time.Duration) {
    <div>
        <h1>Config Summary</h1>
        <p>Output Path: { outputPath }</p>
        <p>Total Time: { formatDuration(totalTimeTaken) }</p>


        if len(config.Design.GlobalParams) > 0 {
            <h2>Global Parameters</h2>
            for name, value := range config.Design.GlobalParams {
                <p><strong>{ name }:</strong> { fmt.Sprintf("%v", value) }</p>
            }
        } else {
            <p>No global parameters</p>
        }
        
        <h2>Output Paths</h2>
        <p><strong>OutputPath:</strong> { outputPath }</p>
        
        <p class="is-size-6 is-italic is-text-grey is-centered">Total processing time: { formatDuration(totalTimeTaken) }</p>
                <p class="is-size-6 is-italic is-text-grey is-centered">Generated by <a href="https://github.com/kiwikid/openscadgen" target="_blank">openscadgen</a> { config.OpenSCADVersion } { config.OpenScadGenVersion } at { time.Now().Format("2006-01-02 15:04:05") }</p>

        <br/>
        <br/>
        <br/>
        <br/>
    </div>
}
