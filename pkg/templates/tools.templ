package templates

import "fmt"

type ToolLink struct {
	Title                 string
	Slug                  string
	Description           string
	URL                   string
	External              bool
	Badge                 string
	Version               string
	IsBOSL2InstallableLib bool
	SupportsUpdateFlow    bool
	CheckUpdatesURL       string
	UpdateURL             string
	SupportsInstallFlow   bool
	InstallURL            string
	InstallNightlyDefault bool
}

// LibraryLink describes a supported OpenSCAD library and whether it was found
// in one of the local OpenSCAD library directories.
type LibraryLink struct {
	ID               string
	Name             string
	Description      string
	URL              string
	Installed        bool
	Version          string
	Path             string
	InstallSupported bool
	InstallURL       string
}

templ ToolsPage(v OpenSCADNavView, tools []ToolLink, libraries []LibraryLink, homeURL string, showAI bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>OpenSCADGen Tools</title>
			@HeadLinks()
			<style>
				.tools-page {
					max-width: 72rem;
					margin: 0 auto;
					padding: 1.5rem;
				}
				.tools-hero {
					padding: 1.5rem;
					border-radius: 1rem;
					background: linear-gradient(135deg, rgba(0,102,204,0.12), rgba(0,0,0,0.02));
					border: 1px solid rgba(0,0,0,0.08);
					margin-bottom: 1.25rem;
				}
				.tools-grid {
					display: grid;
					grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
					gap: 1rem;
				}
				.library-list {
					display: grid;
					gap: 0.75rem;
				}
				.library-row {
					display: flex;
					gap: 0.75rem;
					align-items: flex-start;
					padding: 0.85rem 1rem;
					border: 1px solid rgba(0,0,0,0.08);
					border-radius: 0.75rem;
					background: rgba(255,255,255,0.9);
				}
				.library-row input[type="checkbox"] {
					margin-top: 0.3rem;
					width: 1.1rem;
					height: 1.1rem;
				}
				.library-row__body {
					flex: 1 1 auto;
					min-width: 0;
				}
				.tool-card {
					height: 100%;
					border: 1px solid rgba(0,0,0,0.08);
					border-radius: 0.9rem;
					padding: 1rem;
					background: rgba(255,255,255,0.9);
				}
				.tool-card__meta {
					display: flex;
					gap: 0.5rem;
					flex-wrap: wrap;
					margin-top: 0.75rem;
				}
				.tools-results {
					margin-top: 1.5rem;
				}
			</style>
		</head>
		<body>
			<div class="tools-page">
				<div class="is-flex is-justify-content-space-between is-align-items-center mb-4" style="gap: 1rem; flex-wrap: wrap;">
					<div class="buttons are-small">
						<a class="button is-light" href={ templ.SafeURL(homeURL) }>Home</a>
					</div>
					@OpenSCADNavWidget(v)
				</div>
				<section class="tools-hero">
					<p class="title is-3 mb-2">Tools</p>
					<p class="subtitle is-6 mb-0">A short list of utilities and libraries that pair well with OpenSCADGen.</p>
				</section>
				<section class="tools-libraries mb-5" aria-labelledby="libraries-heading">
					<div class="is-flex is-justify-content-space-between is-align-items-start mb-3" style="gap: 1rem; flex-wrap: wrap;">
						<div>
							<h2 id="libraries-heading" class="title is-4 mb-1">Libraries</h2>
							<p class="is-size-7 mb-0">Libraries found in your local OpenSCAD library folders. Tick an unchecked library to install it.</p>
						</div>
						<span class="tag is-light">{ fmt.Sprintf("%d supported", len(libraries)) }</span>
					</div>
					@OpenSCADLibraryList(libraries, false)
				</section>
				<div class="tools-grid">
					for _, tool := range tools {
						if !showAI && (tool.Title == "AI Chat" || tool.Badge == "AI") {
							continue
						}
						<article class="tool-card">
							<div class="is-flex is-justify-content-space-between is-align-items-start" style="gap: 1rem;">
								<div>
									<p class="title is-5 mb-2">{ tool.Title }</p>
									<p class="content is-small">{ tool.Description }</p>
								</div>
								if tool.Badge != "" {
									<span class="tag is-info is-light">{ tool.Badge }</span>
								}
							</div>
							<div class="tool-card__meta">
								if tool.IsBOSL2InstallableLib {
									<span class="tag is-success is-light">Installable</span>
								}
								if tool.Version != "" {
									<span class="tag is-info is-light">{ tool.Version }</span>
								}
								<a
									class="button is-link is-light is-small"
									href={ templ.SafeURL(tool.URL) }
									if tool.External {
										target="_blank"
										rel="noreferrer"
									}
								>{ fmt.Sprintf("Open %s", tool.Title) }</a>
								if tool.SupportsUpdateFlow && tool.CheckUpdatesURL != "" {
									<button
										type="button"
										class="button is-small is-light"
										hx-get={ templ.SafeURL(tool.CheckUpdatesURL) }
										hx-target="#tools-results-content"
										hx-swap="innerHTML"
									>Check for updates</button>
								}
								if tool.SupportsUpdateFlow && tool.UpdateURL != "" {
									<button
										type="button"
										class="button is-small is-warning is-light"
										hx-post={ templ.SafeURL(tool.UpdateURL) }
										hx-target="#tools-results-content"
										hx-swap="innerHTML"
									>Update</button>
								}
								if tool.SupportsInstallFlow && tool.InstallURL != "" {
									if v.InstallSupported {
										<form
											class="is-flex is-align-items-center is-flex-wrap-wrap"
											style="gap: 0.5rem;"
											hx-post={ templ.SafeURL(tool.InstallURL) }
											hx-target="#tools-results-content"
											hx-swap="innerHTML"
										>
											<label class="checkbox is-size-7">
												<input type="checkbox" name="install_nightly" value="true" checked={ tool.InstallNightlyDefault }/>
												Install latest nightly
											</label>
											<button type="submit" class="button is-small is-primary">Install OpenSCAD</button>
										</form>
									} else {
										<span class="has-text-grey is-size-7">OpenSCAD installation is currently supported on macOS only.</span>
									}
								}
								if tool.IsBOSL2InstallableLib {
									<span class="has-text-grey is-size-7">Results appear below.</span>
								}
							</div>
						</article>
					}
				</div>
				<section class="tools-results" aria-labelledby="tools-results-heading">
					<h2 id="tools-results-heading" class="title is-4">Results</h2>
					<div id="tools-results-content" class="notification is-light">
						Run an install, upgrade, or compatibility check to see its result here.
					</div>
				</section>
			</div>
		</body>
	</html>
}

templ OpenSCADLibraryList(libraries []LibraryLink, oob bool) {
	<div id="openscad-library-list" class="library-list" if oob { hx-swap-oob="outerHTML" }>
		if len(libraries) == 0 {
			<p class="has-text-grey is-size-7">No supported libraries are configured.</p>
		}
		for _, library := range libraries {
			<label class="library-row">
				<input
					type="checkbox"
					name="library"
					value={ library.ID }
					checked?={ library.Installed }
					disabled?={ library.Installed || !library.InstallSupported }
					hx-post={ templ.SafeURL(library.InstallURL) }
					hx-trigger="change"
					hx-target="#tools-results-content"
					hx-swap="innerHTML"
					hx-include="this"
				/>
				<span class="library-row__body">
					<span class="is-flex is-align-items-center is-flex-wrap-wrap" style="gap: 0.5rem;">
						<strong>{ library.Name }</strong>
						if library.Installed {
							<span class="tag is-success is-light">Installed</span>
						} else {
							<span class="tag is-warning is-light">Not installed</span>
						}
						if library.Version != "" {
							<span class="tag is-info is-light">{ library.Version }</span>
						}
						if !library.InstallSupported {
							<span class="tag is-light">Install unavailable</span>
						}
					</span>
					<span class="is-size-7" style="display:block; margin-top: 0.25rem;">{ library.Description }</span>
					if library.Path != "" {
						<code class="is-size-7" style="display:block; margin-top: 0.35rem; word-break: break-all;">{ library.Path }</code>
					} else if library.InstallSupported {
						<span class="has-text-grey is-size-7" style="display:block; margin-top: 0.35rem;">Tick to install into your local OpenSCAD libraries.</span>
					}
				</span>
			</label>
		}
	</div>
}
