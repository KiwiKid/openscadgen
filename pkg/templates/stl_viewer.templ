package templates

import "fmt"
import "github.com/kiwikid/openscadgen/pkg/models"



templ STLViewer(params models.STLViewerParams) {

		<div id="container" x-data="stlViewer()">

            <input type="hidden" id="stlPath" value={ params.STLPath }>
			<div id="loading">Loading STL... { params.STLPath }</div>
			
			<!-- Enhanced Controls Panel -->
			<div id="controls" style="display: none;" class="controls-panel">
				<div class="controls-header">
					<h3>STL Viewer Controls</h3>
					<button @click="toggleControls()" class="toggle-btn">Hide Controls</button>
				</div>
				
				<div class="controls-content" x-show="showControls">
					<!-- Material Controls -->
					<div class="control-section">
						<h4>Material</h4>
						<div class="control-group">
							<label>Color:</label>
							<input type="color" x-model="materialColor" @input="updateMaterial()">
						</div>
						<div class="control-group">
							<label>Wireframe:</label>
							<input type="checkbox" x-model="wireframe" @change="updateMaterial()">
						</div>
						<div class="control-group">
							<label>Shininess:</label>
							<input type="range" min="0" max="200" x-model="shininess" @input="updateMaterial()">
							<span x-text="shininess"></span>
						</div>
						<div class="control-group">
							<label>Opacity:</label>
							<input type="range" min="0" max="1" step="0.1" x-model="opacity" @input="updateMaterial()">
							<span x-text="opacity"></span>
						</div>
					</div>

					<!-- Lighting Controls -->
					<div class="control-section">
						<h4>Lighting</h4>
						<div class="control-group">
							<label>Ambient Light:</label>
							<input type="range" min="0" max="2" step="0.1" x-model="ambientIntensity" @input="updateLighting()">
							<span x-text="ambientIntensity"></span>
						</div>
						<div class="control-group">
							<label>Directional Light:</label>
							<input type="range" min="0" max="2" step="0.1" x-model="directionalIntensity" @input="updateLighting()">
							<span x-text="directionalIntensity"></span>
						</div>
						<div class="control-group">
							<label>Light Color:</label>
							<input type="color" x-model="lightColor" @input="updateLighting()">
						</div>
						<div class="control-group">
							<label>Light Position X:</label>
							<input type="range" min="-100" max="100" x-model="lightPosition.x" @input="updateLighting()">
							<span x-text="lightPosition.x"></span>
						</div>
						<div class="control-group">
							<label>Light Position Y:</label>
							<input type="range" min="-100" max="100" x-model="lightPosition.y" @input="updateLighting()">
							<span x-text="lightPosition.y"></span>
						</div>
						<div class="control-group">
							<label>Light Position Z:</label>
							<input type="range" min="-100" max="100" x-model="lightPosition.z" @input="updateLighting()">
							<span x-text="lightPosition.z"></span>
						</div>
					</div>

					<!-- Camera Controls -->
					<div class="control-section">
						<h4>Camera</h4>
						<div class="control-group">
							<label>Auto Rotate:</label>
							<input type="checkbox" x-model="autoRotate" @change="updateCamera()">
						</div>
						<div class="control-group">
							<label>Rotation Speed:</label>
							<input type="range" min="0.1" max="5" step="0.1" x-model="rotationSpeed" @input="updateCamera()">
							<span x-text="rotationSpeed"></span>
						</div>
						<div class="control-group">
							<label>Zoom Speed:</label>
							<input type="range" min="0.1" max="5" step="0.1" x-model="zoomSpeed" @input="updateCamera()">
							<span x-text="zoomSpeed"></span>
						</div>
						<div class="control-group">
							<label>Pan Speed:</label>
							<input type="range" min="0.1" max="5" step="0.1" x-model="panSpeed" @input="updateCamera()">
							<span x-text="panSpeed"></span>
						</div>
					</div>

					<!-- Rendering Controls -->
					<div class="control-section">
						<h4>Rendering</h4>
						<div class="control-group">
							<label>Background Color:</label>
							<input type="color" x-model="backgroundColor" @input="updateBackground()">
						</div>
						<div class="control-group">
							<label>Shadows:</label>
							<input type="checkbox" x-model="shadows" @change="updateShadows()">
						</div>
						<div class="control-group">
							<label>Antialias:</label>
							<input type="checkbox" x-model="antialias" @change="updateRenderer()">
						</div>
					</div>

					<!-- Model Controls -->
					<div class="control-section">
						<h4>Model</h4>
						<div class="control-group">
							<label>Scale:</label>
							<input type="range" min="0.1" max="5" step="0.1" x-model="modelScale" @input="updateModel()">
							<span x-text="modelScale"></span>
						</div>
						<div class="control-group">
							<label>Position X:</label>
							<input type="range" min="-50" max="50" x-model="modelPosition.x" @input="updateModel()">
							<span x-text="modelPosition.x"></span>
						</div>
						<div class="control-group">
							<label>Position Y:</label>
							<input type="range" min="-50" max="50" x-model="modelPosition.y" @input="updateModel()">
							<span x-text="modelPosition.y"></span>
						</div>
						<div class="control-group">
							<label>Position Z:</label>
							<input type="range" min="-50" max="50" x-model="modelPosition.z" @input="updateModel()">
							<span x-text="modelPosition.z"></span>
						</div>
					</div>

					<!-- Action Buttons -->
					<div class="control-section">
						<h4>Actions</h4>
						<div class="control-group">
							<button @click="resetCamera()" class="action-btn">Reset Camera</button>
							<button @click="resetModel()" class="action-btn">Reset Model</button>
							<button @click="resetAll()" class="action-btn">Reset All</button>
						</div>
					</div>
				</div>
			</div>
			
			<div id="info" style="display: none;">
				<div><strong>Instance:</strong> { params.InstanceConfig.Name }</div>
				<div><strong>ID:</strong> { params.InstanceID }</div>
				<div><strong>File:</strong> { params.STLPath }</div>
				<div><strong>Controls:</strong> Left click + drag to rotate, Right click + drag to pan, Scroll to zoom</div>
			</div>
		</div>

		<script>
			// Alpine.js data and methods
			function stlViewer() {
				return {
					// State variables
					showControls: true,
					materialColor: '#00ff88',
					wireframe: false,
					shininess: 100,
					opacity: 1.0,
					ambientIntensity: 0.6,
					directionalIntensity: 0.8,
					lightColor: '#ffffff',
					lightPosition: { x: 50, y: 50, z: 50 },
					autoRotate: false,
					rotationSpeed: 2.0,
					zoomSpeed: 1.0,
					panSpeed: 1.0,
					backgroundColor: '#2a2a2a',
					shadows: true,
					antialias: true,
					modelScale: 1.0,
					modelPosition: { x: 0, y: 0, z: 0 },
					
					// Three.js objects
					scene: null,
					camera: null,
					renderer: null,
					controls: null,
					model: null,
					ambientLight: null,
					directionalLight: null,
					
					// Methods
					toggleControls() {
						this.showControls = !this.showControls;
					},
					
					updateMaterial() {
						if (this.model && this.model.material) {
							this.model.material.color.setHex(this.materialColor.replace('#', '0x'));
							this.model.material.wireframe = this.wireframe;
							this.model.material.shininess = this.shininess;
							this.model.material.opacity = this.opacity;
							this.model.material.transparent = this.opacity < 1.0;
						}
					},
					
					updateLighting() {
						if (this.ambientLight) {
							this.ambientLight.intensity = this.ambientIntensity;
						}
						if (this.directionalLight) {
							this.directionalLight.intensity = this.directionalIntensity;
							this.directionalLight.color.setHex(this.lightColor.replace('#', '0x'));
							this.directionalLight.position.set(this.lightPosition.x, this.lightPosition.y, this.lightPosition.z);
						}
					},
					
					updateCamera() {
						if (this.controls) {
							this.controls.autoRotate = this.autoRotate;
							this.controls.autoRotateSpeed = this.rotationSpeed;
							this.controls.zoomSpeed = this.zoomSpeed;
							this.controls.panSpeed = this.panSpeed;
						}
					},
					
					updateBackground() {
						if (this.scene) {
							this.scene.background = new THREE.Color(this.backgroundColor);
						}
					},
					
					updateShadows() {
						if (this.renderer) {
							this.renderer.shadowMap.enabled = this.shadows;
						}
						if (this.model) {
							this.model.castShadow = this.shadows;
							this.model.receiveShadow = this.shadows;
						}
						if (this.directionalLight) {
							this.directionalLight.castShadow = this.shadows;
						}
					},
					
					updateRenderer() {
						// Note: antialias can't be changed after renderer creation
						console.log('Antialias setting noted for next renderer creation');
					},
					
					updateModel() {
						if (this.model) {
							this.model.scale.setScalar(this.modelScale);
							this.model.position.set(this.modelPosition.x, this.modelPosition.y, this.modelPosition.z);
						}
					},
					
					resetCamera() {
						if (this.model) {
							const box = new THREE.Box3().setFromObject(this.model);
							const center = box.getCenter(new THREE.Vector3());
							const size = box.getSize(new THREE.Vector3());
							const maxDim = Math.max(size.x, size.y, size.z);
							const distance = maxDim * 2;
							
							this.camera.position.set(distance, distance, distance);
							this.controls.target.copy(center);
							this.controls.update();
						}
					},
					
					resetModel() {
						this.modelScale = 1.0;
						this.modelPosition = { x: 0, y: 0, z: 0 };
						this.updateModel();
					},
					
					resetAll() {
						// Reset all values to defaults
						this.materialColor = '#00ff88';
						this.wireframe = false;
						this.shininess = 100;
						this.opacity = 1.0;
						this.ambientIntensity = 0.6;
						this.directionalIntensity = 0.8;
						this.lightColor = '#ffffff';
						this.lightPosition = { x: 50, y: 50, z: 50 };
						this.autoRotate = false;
						this.rotationSpeed = 2.0;
						this.zoomSpeed = 1.0;
						this.panSpeed = 1.0;
						this.backgroundColor = '#2a2a2a';
						this.shadows = true;
						this.antialias = true;
						this.modelScale = 1.0;
						this.modelPosition = { x: 0, y: 0, z: 0 };
						
						// Apply all updates
						this.updateMaterial();
						this.updateLighting();
						this.updateCamera();
						this.updateBackground();
						this.updateShadows();
						this.updateModel();
						this.resetCamera();
					}
				}
			}
			
			// Global Three.js variables for compatibility
			let scene, camera, renderer, controls, model;

			function init() {
				// Get Alpine.js data
				const alpineData = Alpine.$data(document.getElementById('container'));
				
				// Scene
				scene = new THREE.Scene();
				scene.background = new THREE.Color(alpineData.backgroundColor);
				alpineData.scene = scene;

				// Camera
				camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
				camera.position.set(50, 50, 50);
				alpineData.camera = camera;

				// Renderer
				renderer = new THREE.WebGLRenderer({ antialias: alpineData.antialias });
				renderer.setSize(window.innerWidth, window.innerHeight);
				renderer.shadowMap.enabled = alpineData.shadows;
				renderer.shadowMap.type = THREE.PCFSoftShadowMap;
				alpineData.renderer = renderer;
				document.getElementById('container').appendChild(renderer.domElement);

				// Controls
				controls = new THREE.OrbitControls(camera, renderer.domElement);
				controls.enableDamping = true;
				controls.dampingFactor = 0.05;
				controls.autoRotate = alpineData.autoRotate;
				controls.autoRotateSpeed = alpineData.rotationSpeed;
				controls.zoomSpeed = alpineData.zoomSpeed;
				controls.panSpeed = alpineData.panSpeed;
				alpineData.controls = controls;

				// Lighting
				const ambientLight = new THREE.AmbientLight(0x404040, alpineData.ambientIntensity);
				scene.add(ambientLight);
				alpineData.ambientLight = ambientLight;

				const directionalLight = new THREE.DirectionalLight(0xffffff, alpineData.directionalIntensity);
				directionalLight.position.set(alpineData.lightPosition.x, alpineData.lightPosition.y, alpineData.lightPosition.z);
				directionalLight.castShadow = alpineData.shadows;
				scene.add(directionalLight);
				alpineData.directionalLight = directionalLight;

				// Load STL
				loadSTL();

				// Handle window resize
				window.addEventListener('resize', onWindowResize);

				// Start render loop
				animate();
			}

			function loadSTL() {
				const loader = new THREE.STLLoader();
				const alpineData = Alpine.$data(document.getElementById('container'));
				
				const stlPath = document.getElementById('stlPath').value;
				fetch(stlPath, { method: 'HEAD' })
					.then(response => {
						if (!response.ok) {
							throw new Error(`HTTP ${response.status}: ${response.statusText}`);
						}
						const contentLength = response.headers.get('content-length');
						console.log('STL file size:', contentLength, 'bytes');
						
						if (contentLength && parseInt(contentLength) < 84) {
							throw new Error('STL file too small (minimum 84 bytes for valid STL)');
						}
						
						// Now load the STL
						loader.load(stlPath, function (geometry) {
							console.log('STL loaded successfully, vertices:', geometry.attributes.position.count);
							
							// Check if geometry is valid
							if (!geometry.attributes.position || geometry.attributes.position.count === 0) {
								throw new Error('STL file contains no geometry');
							}
							
							// Hide loading
							document.getElementById('loading').style.display = 'none';
							document.getElementById('controls').style.display = 'block';
							document.getElementById('info').style.display = 'block';

							// Create material with Alpine.js values
							const material = new THREE.MeshPhongMaterial({ 
								color: alpineData.materialColor.replace('#', '0x'),
								shininess: alpineData.shininess,
								opacity: alpineData.opacity,
								transparent: alpineData.opacity < 1.0,
								wireframe: alpineData.wireframe
							});

							// Create mesh
							model = new THREE.Mesh(geometry, material);
							model.castShadow = alpineData.shadows;
							model.receiveShadow = alpineData.shadows;
							alpineData.model = model;

							// Center and scale the model
							geometry.computeBoundingBox();
							const box = geometry.boundingBox;
							const center = box.getCenter(new THREE.Vector3());
							const size = box.getSize(new THREE.Vector3());
							const maxDim = Math.max(size.x, size.y, size.z);
							const scale = 20 / maxDim;
							
							model.scale.setScalar(scale * alpineData.modelScale);
							model.position.sub(center.multiplyScalar(scale));
							model.position.add(new THREE.Vector3(alpineData.modelPosition.x, alpineData.modelPosition.y, alpineData.modelPosition.z));
							
							scene.add(model);

							// Adjust camera to fit model
							const sphere = new THREE.Sphere();
							box.getBoundingSphere(sphere);
							const distance = sphere.radius * 2;
							camera.position.set(distance, distance, distance);
							controls.target.set(0, 0, 0);
							controls.update();

						}, function (progress) {
							console.log('Loading progress:', (progress.loaded / progress.total * 100) + '%');
						}, function (error) {
							console.error('STLLoader error:', error);
							document.getElementById('loading').textContent = 'Error: Invalid STL file format'+error.message+"/n/n/n"+error.stack;
						});
					})
					.catch(error => {
						console.error('File check error:', error);
						document.getElementById('loading').textContent = 'Error: ' + error.message;
					});
			}

			function onWindowResize() {
				camera.aspect = window.innerWidth / window.innerHeight;
				camera.updateProjectionMatrix();
				renderer.setSize(window.innerWidth, window.innerHeight);
			}

			function animate() {
				requestAnimationFrame(animate);
				controls.update();
				renderer.render(scene, camera);
			}

			// Initialize when page loads
			init();
		</script>
}

templ STLViewerHeaderBody( params models.STLViewerParams) {
	<html>
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>STL Viewer</title>
		<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/STLLoader.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
		<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
		 @HeadLinks()
		<style>
			body { margin: 0; padding: 0; background: #2a2a2a; font-family: Arial, sans-serif; }
			#container { position: relative; width: 100vw; height: 100vh; }
			#loading { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: white; font-size: 18px; z-index: 100; }
			
			.controls-panel { 
				position: absolute; 
				top: 10px; 
				left: 10px; 
				background: rgba(0,0,0,0.8); 
				padding: 15px; 
				border-radius: 8px; 
				color: white; 
				z-index: 100; 
				max-width: 300px;
				max-height: 80vh;
				overflow-y: auto;
			}
			
			.controls-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 15px;
				border-bottom: 1px solid #444;
				padding-bottom: 10px;
			}
			
			.controls-header h3 {
				margin: 0;
				font-size: 16px;
			}
			
			.toggle-btn {
				background: #007bff;
				color: white;
				border: none;
				padding: 5px 10px;
				border-radius: 4px;
				cursor: pointer;
				font-size: 12px;
			}
			
			.toggle-btn:hover {
				background: #0056b3;
			}
			
			.control-section {
				margin-bottom: 20px;
				border-bottom: 1px solid #333;
				padding-bottom: 15px;
			}
			
			.control-section:last-child {
				border-bottom: none;
			}
			
			.control-section h4 {
				margin: 0 0 10px 0;
				font-size: 14px;
				color: #00ff88;
			}
			
			.control-group { 
				margin-bottom: 8px; 
				display: flex;
				align-items: center;
				gap: 8px;
			}
			
			.control-group label { 
				flex: 1;
				font-size: 12px;
				min-width: 80px;
			}
			
			.control-group input[type="range"] {
				flex: 1;
				margin: 0 5px;
			}
			
			.control-group input[type="color"] {
				width: 30px;
				height: 25px;
				border: none;
				border-radius: 3px;
				cursor: pointer;
			}
			
			.control-group input[type="checkbox"] {
				margin: 0;
			}
			
			.control-group span {
				font-size: 11px;
				color: #ccc;
				min-width: 30px;
				text-align: right;
			}
			
			.action-btn {
				background: #28a745;
				color: white;
				border: none;
				padding: 6px 12px;
				border-radius: 4px;
				cursor: pointer;
				font-size: 11px;
				margin-right: 5px;
				margin-bottom: 5px;
			}
			
			.action-btn:hover {
				background: #218838;
			}
			
			#info { 
				position: absolute; 
				top: 10px; 
				right: 10px; 
				background: rgba(0,0,0,0.7); 
				padding: 10px; 
				border-radius: 5px; 
				color: white; 
				z-index: 100; 
				max-width: 300px; 
			}
		</style>
	</head>
    <body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">

		<a class="button is-warning" href={ templ.SafeURL(fmt.Sprintf("/?config=%s#%s", params.ConfigFilePathBase64, params.InstanceConfig.UniqueID)) }>Cancel</a>
		<button href="/" class="button is-large">Home</button>	
	</nav>
     @STLViewer(params)
	</body>
	</html>
}
