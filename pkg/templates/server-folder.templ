package templates


templ SaveServerFolder(serverFolder string) {
    <script data-server-folder={ serverFolder }>
        (function () {
            const key = 'opensacdgen-serverFolder';
            const lastKey = 'opensacdgen-serverFolder-lastNavigated';

            function setServerFolderOptions() {
                const el = document.querySelector('[data-server-folder]');
                if (!el) {
                    return;
                }

                const serverFolder = el.getAttribute('data-server-folder');
                if (!serverFolder) {
                    return;
                }

                // Track the most recent server folder the user actually navigated to.
                localStorage.setItem(lastKey, serverFolder);

                let currentOptions;
                try {
                    currentOptions = JSON.parse(localStorage.getItem(key) || '[]');
                } catch (e) {
                    currentOptions = [];
                }

                currentOptions.unshift(serverFolder);

                // de-dupe and clamp list
                currentOptions = currentOptions.filter((value, index, self) => {
                    return value && self.indexOf(value) === index;
                }).slice(0, 20);

                localStorage.setItem(key, JSON.stringify(currentOptions));
            }

            window.addEventListener('load', setServerFolderOptions, { once: true });
        })();
    </script>
}

templ ServerFolderOptionsComponent() {
    <script>
        (function () {
            const KEY = 'opensacdgen-serverFolder';
            const LAST_KEY = 'opensacdgen-serverFolder-lastNavigated';

            class ServerFolderOptionsElement extends HTMLElement {
                connectedCallback() {
                    this.render();
                }

                removeFolder(serverFolder) {
                    let options;
                    try {
                        options = JSON.parse(localStorage.getItem(KEY) || '[]');
                    } catch (e) {
                        options = [];
                    }
                    options = options.filter((v) => v !== serverFolder);
                    localStorage.setItem(KEY, JSON.stringify(options));
                    if ((localStorage.getItem(LAST_KEY) || '') === serverFolder) {
                        localStorage.removeItem(LAST_KEY);
                    }
                    this.render();
                }

                render() {
                    const raw = localStorage.getItem(KEY);
                    if (!raw) {
                        this.replaceChildren();
                        return;
                    }

                    let options;
                    try {
                        options = JSON.parse(raw) || [];
                    } catch (e) {
                        console.error('Invalid serverFolder options in localStorage', e);
                        this.replaceChildren();
                        return;
                    }

                    const lastNavigated = localStorage.getItem(LAST_KEY) || '';
                    if (lastNavigated) {
                        // Ensure the last navigated folder is first (even if the list got out of order).
                        options = [
                            lastNavigated,
                            ...options.filter((v) => v && v !== lastNavigated),
                        ];
                    }

                    const frag = document.createDocumentFragment();

                    for (const serverFolder of options) {
                        if (!serverFolder) {
                            continue;
                        }
                        const field = document.createElement('div');
                        field.className = 'field';

                        const control = document.createElement('div');
                        control.className = 'control';
                        control.style.display = 'flex';
                        control.style.gap = '0.5rem';
                        control.style.alignItems = 'center';

                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'button is-large';
                        btn.style.flex = '1 1 auto';
                        btn.style.minWidth = '0';
                        btn.style.overflow = 'hidden';
                        btn.style.textOverflow = 'ellipsis';
                        btn.style.whiteSpace = 'nowrap';
                        btn.dataset.serverFolder = serverFolder;
                        btn.appendChild(document.createTextNode(serverFolder));

                        if (lastNavigated && serverFolder === lastNavigated) {
                            btn.classList.add('is-primary');
                            btn.setAttribute('aria-current', 'true');
                            btn.appendChild(document.createTextNode(' (last)'));
                        } else {
                            btn.classList.add('is-light');
                        }

                        btn.addEventListener('click', () => {
                            // Bubble an event so the host page can decide how to handle selection.
                            this.dispatchEvent(new CustomEvent('server-folder-selected', {
                                bubbles: true,
                                detail: { serverFolder },
                            }));
                        });

                        const removeBtn = document.createElement('button');
                        removeBtn.type = 'button';
                        removeBtn.className = 'button is-danger is-outlined';
                        removeBtn.textContent = '×';
                        removeBtn.setAttribute('aria-label', 'Remove from recent folders');
                        removeBtn.title = 'Remove from recent';
                        removeBtn.addEventListener('click', (e) => {
                            e.stopPropagation();
                            this.removeFolder(serverFolder);
                        });

                        control.appendChild(btn);
                        control.appendChild(removeBtn);
                        field.appendChild(control);
                        frag.appendChild(field);
                    }

                    this.replaceChildren(frag);
                }
            }

            if (!customElements.get('server-folder-options')) {
                customElements.define('server-folder-options', ServerFolderOptionsElement);
            }
        })();
    </script>
}

templ ServerFolderForm(warning templ.Component) {
    @ServerFolderOptionsComponent()
    <server-folder-options></server-folder-options>
}