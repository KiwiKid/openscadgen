templ ProgressContainer(id string) {
    <div id="progress-summary" hx-swap-oob="true">
    <div class="is-loading"></div>
        Starting...
    </div>
    <div id="progress-container" class="box m-3">
        <div class="columns is-vcentered">
            <div class="column">
                <div id="progress" class="notification is-info" hx-get={ fmt.Sprintf("/progress?id=%s", id) } hx-trigger="every 1s" hx-swap="outerHTML">
                    Starting...
                </div>
            </div>
            <div class="column is-narrow">
                <button id="cancel-button" class="button is-danger" hx-get={ fmt.Sprintf("/cancel?id=%s", id) } hx-swap-oob="true">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

templ ProgressUpdate(message string, id string, keepPolling bool) {
    <div id="progress-summary" hx-swap-oob="true" class="is-1"><div class="is-loading"></div> { message }</div>
    <div id="progress" class="notification is-info"
    if keepPolling {
        hx-get={ fmt.Sprintf("/progress?id=%s", id) } hx-trigger="every 1s" hx-swap="outerHTML"
    }>
        <div x-show="showDebug">
            [ProgressUpdate - { fmt.Sprintf("%t", keepPolling) } ]
        </div>
        { message }
    </div>
}

templ ProgressComplete() {
    <div id="progress-summary" hx-swap-oob="true" class="is-1 has-text-success">
        <span class="icon-text">
            <span class="icon">
                <i class="fas fa-check-circle"></i>
            </span>
            <span>All instances completed!</span>
        </span>
    </div>
    <div id="progress" class="notification is-success">
        <span class="icon">
            <i class="fas fa-check-circle"></i>
        </span>
        <span>All instances completed!</span>
    </div>
    <div id="cancel-button" hx-swap-oob="true"></div>
}

templ InstanceStart(name string, instanceIndex int, instanceCount int, id string) {
    <div id="progress-summary" hx-swap-oob="true" class="is-1">
        <div class="fas fa-spinner"></div> { name } ({ fmt.Sprintf("%d/%d", instanceIndex, instanceCount) })
    </div>
    <div id="progress" class="notification is-info" hx-get={ fmt.Sprintf("/progress?id=%s", id) } hx-trigger="every 1s" hx-swap="outerHTML">
        <div class="fas fa-spinner"></div> { name } ({ fmt.Sprintf("%d/%d", instanceIndex, instanceCount) })
    </div>
}